# Copy to backend/.env and adjust. Never commit real secrets.

ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Host-run API -> Docker Postgres. (docker compose overrides this for the api container.)
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5433/documind
# Provider URLs can be pasted as-is (postgresql://...?sslmode=require&channel_binding=require).
# Set true for a PgBouncer *pooled* endpoint (automatic when the host contains "-pooler.").
DATABASE_POOLED=false
# Optional: direct (non-pooled) URL used by Alembic migrations. Falls back to DATABASE_URL.
MIGRATIONS_DATABASE_URL=

# Generate with:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Cookies must be Secure in production; local http dev needs false.
COOKIE_SECURE=false

FRONTEND_URL=http://localhost:5173
# JSON list. Usually empty: the frontend reaches the API same-origin (Vite proxy / Pages Function).
CORS_ORIGINS=[]

# console = print emails to the log (dev only), disabled = drop them, memory = tests
EMAIL_BACKEND=console
EMAIL_VERIFICATION_REQUIRED=false

# Shared secret for POST /api/v1/internal/* (cron job drain). Leave empty to disable those routes.
INTERNAL_API_SECRET=
# Production only: same value as PROXY_SECRET in Cloudflare Pages. When set, /api/* requests that
# don't come through the Pages proxy are refused. Required when ENV=production.
PROXY_SHARED_SECRET=

# Shared read-only demo workspace with synthetic sample documents (app/demo/samples).
DEMO_ENABLED=false

EXPOSE_DOCS=true

# --- Object storage ---
# local = files under STORAGE_LOCAL_DIR (dev). s3 = any S3 API; production uses a PRIVATE Cloudflare R2 bucket.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
# For R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Document limits (free-tier guardrails) ---
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_WORKSPACE=50
MAX_PAGES_PER_DOCUMENT=300
MAX_CHUNKS_PER_WORKSPACE=15000

# --- Background jobs (Postgres queue, runs inside the API process) ---
JOB_RUNNER_ENABLED=true
JOB_POLL_SECONDS=5

# --- AI (Google Gemini) ---
# Get a free key at https://aistudio.google.com -> Get API key. Keep it ONLY in this .env file.
# Free tier: Google may use submitted content to improve its products. Use non-confidential documents.
GEMINI_API_KEY=
# gemini = real API; fake = offline deterministic provider (used by tests/CI, no key needed)
AI_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the halfvec(768) column - changing it requires a migration and re-embedding.
EMBEDDING_DIM=768
AI_DAILY_QUESTIONS_PER_USER=30
AI_DAILY_QUESTIONS_DEMO=10
# Retrieval tuning
RETRIEVAL_FINAL_K=6
RETRIEVAL_MIN_SIMILARITY=0.62
